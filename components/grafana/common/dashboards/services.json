{
  "uid": "services",
  "title": "Services: requests, errors, latency",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "platform"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second, per service and route",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, http_route) (rate(http_server_request_duration_seconds_count[5m]))",
          "legendFormat": "{{service_name}} {{http_route}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Errors (5xx) as a share of requests",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) / sum by (service_name) (rate(http_server_request_duration_seconds_count[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Latency p95, per service and route (dots: sample requests, click for the trace)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name, http_route) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service_name}} {{http_route}}",
          "exemplar": true
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "The gateway: requests per route",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"httproute.*\"}[5m]))",
          "legendFormat": "{{envoy_cluster_name}}"
        }
      ],
      "id": 4
    }
  ]
}
