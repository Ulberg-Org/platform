{
  "uid": "postgres",
  "title": "Postgres",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "platform"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Connections per database",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (postgresql_database_name) (postgresql_backends)",
          "legendFormat": "{{postgresql_database_name}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Commits and rollbacks",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (postgresql_database_name) (rate(postgresql_commits_total[5m]))",
          "legendFormat": "commits {{postgresql_database_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (postgresql_database_name) (rate(postgresql_rollbacks_total[5m]))",
          "legendFormat": "rollbacks {{postgresql_database_name}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(postgresql_blocks_read_total{source=\"heap_hit\"}[5m])) / sum(rate(postgresql_blocks_read_total{source=~\"heap_hit|heap_read\"}[5m]))",
          "legendFormat": "heap hits"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Database size",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (postgresql_database_name) (postgresql_db_size_bytes)",
          "legendFormat": "{{postgresql_database_name}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Deadlocks",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(postgresql_deadlocks_total[1h]))",
          "legendFormat": "deadlocks"
        }
      ],
      "id": 5
    }
  ]
}
