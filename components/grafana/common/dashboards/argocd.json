{
  "uid": "argocd",
  "title": "Argo CD: sync and health",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "platform"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Applications not in sync",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (name) (argocd_app_info{sync_status!=\"Synced\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Applications not healthy",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (name, health_status) (argocd_app_info{health_status!=\"Healthy\"})",
          "legendFormat": "{{name}} {{health_status}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Syncs per application",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name, phase) (increase(argocd_app_sync_total[1h]))",
          "legendFormat": "{{name}} {{phase}}"
        }
      ],
      "id": 3
    }
  ]
}
