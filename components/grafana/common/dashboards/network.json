{
  "uid": "network",
  "title": "Network: dropped connections",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "platform"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Drops per reason",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(hubble_drop_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Dropped by the network rules, per source and destination namespace",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, destination) (rate(hubble_policy_verdicts_total{action=\"dropped\"}[5m]))",
          "legendFormat": "{{source}} -> {{destination}}"
        }
      ],
      "id": 2
    },
    {
      "type": "logs",
      "title": "Dropped flows (Hubble)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"network-flows\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "id": 3
    }
  ]
}
