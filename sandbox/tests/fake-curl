#!/usr/bin/env bash
# A stand-in for curl in test_azure_read.sh: prints the request (method, URL, Authorization) and the body read
# from stdin, one per line.
method=GET url="" auth="" body=""
while [ $# -gt 0 ]; do
  case "$1" in
    -X) method=$2; shift 2 ;;
    -H) [[ $2 == Authorization:* ]] && auth=$2; shift 2 ;;
    --data) method=POST; body=$(cat); shift 2 ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done
printf '%s %s\n%s\n%s\n' "$method" "$url" "$auth" "$body"
