# What the bootstrap installs before Argo CD takes over (D67), pinned (D61, D65). The platform components'
# versions are in components/*/component.yaml, where Argo CD reads them too.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# AKS runs Cilium 1.19 with Kubernetes 1.36 (its 1.37 version isn't published yet); recheck when Phase 3
# creates AKS. 1.19.10: the newest patch past the cooldown.
CILIUM_CHART_VERSION=1.19.10
POSTGRES_IMAGE=postgres:18.7
