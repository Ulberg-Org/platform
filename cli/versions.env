CILIUM_CHART_VERSION=1.20.5
ENVOY_GATEWAY_CHART_VERSION=v1.10.0
POSTGRES_IMAGE=postgres:18.7
# Argo CD 3.6.1: the newest chart past the update cooldown (D65: a new minor waits 14 days).
ARGOCD_CHART_VERSION=10.14.0
# The git server reuses Argo CD's image (the chart's version): it's in the cluster already and has a full git.
GIT_SERVER_IMAGE=quay.io/argoproj/argocd:v3.6.1@sha256:296e3d74f449b2ce45265613fcb68c18ed7366488360c8ea32f5f2a93d2e5c54
